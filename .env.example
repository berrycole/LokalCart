CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

logger.threshold = 4

# MySQL settings for Technical Formative Assessment 4 (existing TFA3 database).
# Change the username and password if your local MySQL installation uses different values.
database.default.hostname = localhost
database.default.database = lokalcart_pos_tfa3
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

# Used only to initialize existing users when running php spark migrate.
TFA4_INITIAL_PASSWORD = 'LokalCart2026!'
